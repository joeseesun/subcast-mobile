{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubCast",
  "version": "0.1.2",
  "identifier": "ai.qiaomu.subcast.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/downloads/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "海外播客与 YouTube 双语字幕、AI 问答",
    "category": "Education",
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "BRCU3DPFH4",
      "bundleVersion": "5"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQTM2MUQxOUYzRTgyNjAKUldSZ2dqNmYwV0dqb1Job2pZbDNwdGNVRStuUitFaVVTVnVjcnRUeWRzOENOVHNmZ3lTOXVOYjEK",
      "endpoints": [
        "https://subcast.qiaomu.ai/download/latest.json",
        "https://github.com/joeseesun/subcast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
